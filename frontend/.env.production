# Used only for production builds (`npm run build` / the deploy scripts).
# Empty on purpose: the server's Nginx reverse-proxies /auth, /chats, /ws,
# etc. to the backend on the same origin (see the ak-backend Nginx site
# config), so the frontend should call relative URLs rather than a
# hardcoded LAN IP — that's what frontend/.env (dev-only, git-ignored) is
# for instead.
VITE_API_BASE_URL=
